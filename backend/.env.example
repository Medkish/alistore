# AlioStore backend environment
# Copy to .env and fill in your PostgreSQL connection string.
# Cloud options: Neon (neon.tech), Supabase (supabase.com) - both have free tiers.
# Replace USER, PASSWORD, HOST, PORT, DBNAME with your real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# API port (the Next.js frontend talks to this in dev)
PORT=4000

# Comma-separated list of allowed frontend origins (default: allow all)
#CORS_ORIGIN="http://localhost:3000,https://medkish.github.io"

# General API rate limit per IP per 15 minutes (default 300)
#RATE_LIMIT_MAX=300

# Where uploaded book covers are saved.
# Default: ../../frontend/public/images/uploads (served at /images)
#UPLOAD_DIR="C:/AliStore/uploads"

# Storage provider label reported by GET /api/config ("local" or e.g. "cloudinary")
STORAGE_PROVIDER="local"

# Real payment integrations go here later (Stripe) - NEVER put these in frontend code.
#STRIPE_SECRET_KEY="sk_live_..."
#STRIPE_WEBHOOK_SECRET="whsec_..."