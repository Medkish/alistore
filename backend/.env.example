# AlioStore backend environment
# Copy to .env and fill in your PostgreSQL connection string.
# Cloud options: Neon (neon.tech), Supabase (supabase.com) - both have free tiers.
# Replace USER, PASSWORD, HOST, PORT, DBNAME with your real values.
# Use a SEPARATE database for development and production - never share one.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require"

# API port (the Next.js frontend talks to this in dev)
PORT=4000

# Comma-separated list of allowed frontend origins (default: allow all)
#CORS_ORIGIN="http://localhost:3000,https://medkish.github.io,https://yourdomain.com"

# General API rate limit per IP per 15 minutes (default 300)
#RATE_LIMIT_MAX=300

# Auth rate limit per IP per 15 minutes (login/register, default 30)
#AUTH_RATE_LIMIT_MAX=30

# Session lifetime in hours (default 168 = 7 days). Set 0 to never expire.
#SESSION_TTL_HOURS=168

# Where uploaded book covers are saved.
# Default: ../../frontend/public/images/uploads (served at /images)
#UPLOAD_DIR="C:/AliStore/uploads"

# Storage provider label reported by GET /api/config ("local" or e.g. "cloudinary")
STORAGE_PROVIDER="local"

# Restrict which admin tools are live in production (true/false)
#PROD=false

# Real payment integrations go here later (Stripe) - NEVER put these in frontend code.
#STRIPE_SECRET_KEY="sk_live_..."
#STRIPE_WEBHOOK_SECRET="whsec_..."

# Secret used to HMAC-sign payment webhook callbacks from the provider.
# Generate one: openssl rand -hex 32
#PAYMENT_WEBHOOK_SECRET=""

# Email notifications (Order Placed -> ... -> Delivered). Provider "log" works
# without any SMTP server (writes to EmailLog table). Set "smtp" to send real mail.
#EMAIL_PROVIDER="log"
#EMAIL_FROM="AlioStore <no-reply@yourdomain.com>"
#SMTP_HOST=""
#SMTP_PORT=587
#SMTP_USER=""
#SMTP_PASSWORD=""
#SMTP_SECURE=false